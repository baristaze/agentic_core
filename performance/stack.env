# The engine's settings for the performance stack, as a deployment's
# runner reads them from its environment: each role on its own Postgres,
# tool outputs in MinIO, the cache and the topics on Valkey, and the KMS
# adapter at the emulator. `make performance` sources this file, so each
# port is the knob compose.yml reads, with its default. The run sets
# ACME_KEYS_BACKEND itself, once per key configuration.
ACME_ENVIRONMENT=local

CORE=127.0.0.1:${PERFORMANCE_POSTGRES_CORE_PORT:-61432}
ACTIVITY=127.0.0.1:${PERFORMANCE_POSTGRES_ACTIVITY_PORT:-61433}
QUEUE=127.0.0.1:${PERFORMANCE_POSTGRES_QUEUE_PORT:-61434}
ADMIN=127.0.0.1:${PERFORMANCE_POSTGRES_ADMIN_PORT:-61435}
ACME_DATABASE_URL=postgresql+asyncpg://acme_runtime:acme_runtime@$CORE/acme
ACME_DATABASE_SYSTEM_URL=postgresql+asyncpg://acme_system:acme_system@$CORE/acme
ACME_DATABASE_MIGRATION_URL=postgresql+asyncpg://acme_migration:acme_migration@$CORE/acme
ACME_DATABASE_MASTER_URL=postgresql+asyncpg://acme:acme@$CORE/acme
ACME_DATABASE_PURGE_URL=postgresql+asyncpg://acme_purge:acme_purge@$CORE/acme
ACME_DATABASE_URL_CORE=postgresql+asyncpg://acme_runtime:acme_runtime@$CORE/acme
ACME_DATABASE_URL_ACTIVITY=postgresql+asyncpg://acme_runtime:acme_runtime@$ACTIVITY/acme
ACME_DATABASE_URL_QUEUE=postgresql+asyncpg://acme_runtime:acme_runtime@$QUEUE/acme
ACME_DATABASE_URL_ADMIN=postgresql+asyncpg://acme_runtime:acme_runtime@$ADMIN/acme

ACME_CACHE_BACKEND=valkey
ACME_TOPICS_BACKEND=valkey
ACME_VALKEY_URL=valkey://127.0.0.1:${PERFORMANCE_VALKEY_PORT:-61379}/0

ACME_BUCKETS_BACKEND=s3
ACME_S3_ENDPOINT_URL=http://127.0.0.1:${PERFORMANCE_MINIO_PORT:-61900}
ACME_S3_ACCESS_KEY=acme
ACME_S3_SECRET_KEY=acme-minio-local
ACME_S3_BUCKET_PREFIX=acme-performance

ACME_QUEUES_BACKEND=memory
ACME_SECRETS_BACKEND=local
ACME_FLAGS_BACKEND=memory
ACME_AWS_REGION=us-east-1
ACME_KMS_KEY_ID=alias/acme-sessions
# The KMS adapter names no endpoint of its own; botocore reads this one
# for KMS alone.
AWS_ENDPOINT_URL_KMS=http://127.0.0.1:${PERFORMANCE_KMS_PORT:-61800}
