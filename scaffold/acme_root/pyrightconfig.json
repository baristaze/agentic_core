{
  "include": ["om/src", "om/tests", "om/migrations", "infra/src", "infra/tests", "integrations/src", "integrations/tests", "services/api/src", "services/api/tests", "workers/maintenance/src", "workers/maintenance/tests", "workers/session_runner/src", "workers/session_runner/tests", "clients/python/src", "clients/python/tests", "apps/cli/src", "apps/cli/tests", "ops/src", "ops/tests", "ops/audit", "checkers/src", "checkers/tests", "scripts"],
  "exclude": ["**/node_modules", "**/.venv", "**/__pycache__"],
